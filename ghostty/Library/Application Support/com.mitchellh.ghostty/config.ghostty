# ============================================================
# Ghostty config — based on kitty.conf setup
# ============================================================

# Font
font-size = 18
font-family = "Hack Nerd Font Mono"

# Opacity & blur
background-opacity = 0.8
background-blur = 20

# Window
macos-titlebar-style = hidden
window-padding-x = 4
window-padding-y = 4

# Cursor
cursor-style = bar
cursor-style-blink = false

# Terminal
mouse-hide-while-typing = true
confirm-close-surface = false

# ============================================================
# KEYBINDS
# ============================================================

# Sequence prefix: ctrl+a then key
# Splits (v=vertical right, h=horizontal down)
keybind = ctrl+a>v=new_split:right
keybind = ctrl+a>h=new_split:down

# Pane navigation
keybind = ctrl+a>left=goto_split:left
keybind = ctrl+a>right=goto_split:right
keybind = ctrl+a>up=goto_split:up
keybind = ctrl+a>down=goto_split:down

# Tabs
keybind = ctrl+a>c=new_tab
keybind = ctrl+a>n=next_tab
keybind = ctrl+a>p=previous_tab

# ============================================================
# THEME — Duotone Amethyst (deep purple base + gold accent)
# ============================================================
palette = 0=#181425
palette = 1=#b89cf0
palette = 2=#a88ae0
palette = 3=#f5c842
palette = 4=#7b5db8
palette = 5=#c4a9f8
palette = 6=#9b7dd6
palette = 7=#ddd6f0
palette = 8=#282240
palette = 9=#c4a9f8
palette = 10=#b89cf0
palette = 11=#f7d56a
palette = 12=#9b7dd6
palette = 13=#ddd6f0
palette = 14=#c4a9f8
palette = 15=#ede8f5

foreground = #ddd6f0
background = #181425

cursor-color = #f5c842
cursor-text = #181425

selection-foreground = #181425
selection-background = #f5c842
