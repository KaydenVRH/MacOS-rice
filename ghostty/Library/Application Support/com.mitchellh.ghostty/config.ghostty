# ============================================================
# Ghostty config — based on kitty.conf setup
# ============================================================

# Font
font-size = 18
font-family = "Hack Nerd Font Mono"

# Opacity & blur
background-opacity = 0.8
background-blur = 20

# Window
macos-titlebar-style = hidden
window-padding-x = 4
window-padding-y = 4

# Cursor
cursor-style = bar
cursor-style-blink = false

# Terminal
mouse-hide-while-typing = true
confirm-close-surface = false

# ============================================================
# KEYBINDS
# ============================================================

# Sequence prefix: ctrl+a then key
# Splits (v=vertical right, h=horizontal down)
keybind = ctrl+a>v=new_split:right
keybind = ctrl+a>h=new_split:down

# Pane navigation
keybind = ctrl+a>left=goto_split:left
keybind = ctrl+a>right=goto_split:right
keybind = ctrl+a>up=goto_split:up
keybind = ctrl+a>down=goto_split:down

# Tabs
keybind = ctrl+a>c=new_tab
keybind = ctrl+a>n=next_tab
keybind = ctrl+a>p=previous_tab

# ============================================================
# THEME — Amber Amethyst (deep purple + gold)
# ============================================================
palette = 0=#1e1a2e
palette = 1=#ef4444
palette = 2=#34d399
palette = 3=#fbbf24
palette = 4=#818cf8
palette = 5=#a855f7
palette = 6=#22d3ee
palette = 7=#e2e8f0
palette = 8=#352f50
palette = 9=#f87171
palette = 10=#6ee7b7
palette = 11=#fde68a
palette = 12=#a5b4fc
palette = 13=#c084fc
palette = 14=#67e8f9
palette = 15=#f8fafc

foreground = #e2e8f0
background = #1e1a2e

cursor-color = #fbbf24
cursor-text = #1e1a2e

selection-foreground = #e2e8f0
selection-background = #a855f7
