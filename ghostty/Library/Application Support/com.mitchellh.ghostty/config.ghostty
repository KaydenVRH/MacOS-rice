# ============================================================
# Ghostty config — based on kitty.conf setup
# ============================================================

# Font
font-size = 18
font-family = "Hack Nerd Font Mono"

# Opacity & blur
background-opacity = 0.8
background-blur = 20

# Window
macos-titlebar-style = hidden
window-padding-x = 4
window-padding-y = 4

# Cursor
cursor-style = bar
cursor-style-blink = false

# Terminal
mouse-hide-while-typing = true
confirm-close-surface = false

# ============================================================
# KEYBINDS
# ============================================================

# Sequence prefix: ctrl+a then key
# Splits (v=vertical right, h=horizontal down)
keybind = ctrl+a>v=new_split:right
keybind = ctrl+a>h=new_split:down

# Pane navigation
keybind = ctrl+a>left=goto_split:left
keybind = ctrl+a>right=goto_split:right
keybind = ctrl+a>up=goto_split:up
keybind = ctrl+a>down=goto_split:down

# Tabs
keybind = ctrl+a>c=new_tab
keybind = ctrl+a>n=next_tab
keybind = ctrl+a>p=previous_tab

# ============================================================
# THEME — Blue Lagoon (soft blue)
# ============================================================
palette = 0=#0e1419
palette = 1=#89cff0
palette = 2=#a8e6cf
palette = 3=#ffd3b6
palette = 4=#6ba3ff
palette = 5=#c3aedb
palette = 6=#7ecfd4
palette = 7=#e8f0f8
palette = 8=#1a2a38
palette = 9=#a8ddf5
palette = 10=#b8f0df
palette = 11=#ffe0c4
palette = 12=#8bbaff
palette = 13=#d4c4e8
palette = 14=#9edfe3
palette = 15=#f0f6fc

foreground = #e8f0f8
background = #0e1419

cursor-color = #89cff0
cursor-text = #0e1419

selection-foreground = #e8f0f8
selection-background = #1a2a38
