# Everforest — nature-inspired, muted greens, warm earth tones
ACCENT=0xffa78bfa
HIGHLIGHT=0xffb8a4f0

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar position=top height=34 margin=2 y_offset=4 corner_radius=8 blur_radius=0 color=0x00000000 display=main

##### Changing Defaults #####
default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=$ACCENT
  label.color=$HIGHLIGHT
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

sketchybar --add event aerospace_workspace_change

SPACES=()
for sid in $(aerospace list-workspaces --all); do
    SPACES+=("space.$sid")
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
        background.drawing=off \
        background.corner_radius=6 \
        padding_left=1 \
        padding_right=1 \
        drawing=off \
        label="$sid" \
        label.color=$ACCENT \
        label.highlight_color=$HIGHLIGHT \
        click_script="aerospace workspace $sid" \
        script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

sketchybar --add item chevron left \
           --set chevron icon= label.drawing=off icon.color=$ACCENT \
           --add item front_app left \
           --set front_app icon.drawing=off \
            label.padding_left=32 \
            background.height=34 \
           background.corner_radius=5 \
            script="$PLUGIN_DIR/front_app.sh" \
            --subscribe front_app front_app_switched

##### Adding Right Items #####
sketchybar --add item clock right \
            --set clock update_freq=10 icon= script="$PLUGIN_DIR/clock.sh" \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add item cpu right \
           --set cpu update_freq=5 icon= script="$PLUGIN_DIR/cpu.sh" \
           --add item ram right \
           --set ram update_freq=5 icon= script="$PLUGIN_DIR/ram.sh" \
           --add item wifi right \
           --set wifi update_freq=10 icon= icon.color=0xffa7c080 script="$PLUGIN_DIR/wifi.sh" \
           --add item bluetooth right \
           --set bluetooth update_freq=30 icon= icon.color=0xffa7c080 script="$PLUGIN_DIR/bluetooth.sh" \
            --add item brew right \
            --set brew \
             icon= \
             icon.padding_left=4 \
             icon.padding_right=4 \
             label.padding_right=4 \
             label.drawing=off \
             script="$PLUGIN_DIR/brew.sh" \
             update_freq=3600

sketchybar --add item now_playing left \
           --set now_playing \
             label.drawing=on \
             label="--" \
             label.padding_left=14 \
             label.padding_right=14 \
             label.max_chars=35 \
            scroll_texts=on \
            background.drawing=on \
            background.color=0xCC120e1a \
            background.corner_radius=6 \
            background.height=28 \
            script="$PLUGIN_DIR/now_playing.sh" \
            update_freq=5 \
            --subscribe now_playing media_change

sketchybar --add bracket left_group ${SPACES[@]} chevron front_app \
           --set left_group background.color=0xCC120e1a background.corner_radius=6 background.height=28

sketchybar --add bracket right_group clock volume battery cpu ram wifi bluetooth brew \
           --set right_group background.color=0xCC120e1a background.corner_radius=6 background.height=28

sketchybar --update
